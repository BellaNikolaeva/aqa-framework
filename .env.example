AQA_BASE_URL=https://book-tracker-api-frnm.onrender.com
AQA_TIMEOUT=60
AQA_RETRY_ATTEMPTS=3
AQA_RETRY_WAIT_SECONDS=5

# Только для docker-compose (сервис load-test) — цель для Locust,
# отдельно от AQA_BASE_URL, т.к. подставляется на уровне compose-файла,
# а не читается через pydantic-settings.
AQA_LOCUST_HOST=https://book-tracker-api-frnm.onrender.com
